# Copy this to prod.env and fill in the <FILL IN> values before running any
# deploy/NN-*.sh script with `prod` as the environment. Everything here mirrors
# envs/qa.env one-for-one — see that file for what each value actually controls
# and where it was originally set for QA.
#
# Do NOT reuse any QA secret/credential/token for prod (KMS key, RDS password,
# Keycloak client secrets, DB users) — these must all be freshly generated.
# This file itself holds no secrets, only names/endpoints/hostnames; real
# secrets are entered interactively when 04-setup-keycloak.sh /
# 05-seed-vault-secrets.sh prompt for them, never written to disk here.

ENVIRONMENT=prod
IMAGE_TAG=prod

# Host — second EC2 instance, fully separate box/cluster from QA
EC2_HOSTNAME=landers-prod

# DNS / ALB — decide the prod subdomain scheme before running 08/10 (see
# EC2_QA_Environment_Setup_Guide.txt Part 6's naming note: QA prefixes with
# "qa-"/"-qa", prod dropping that prefix is the obvious default but wasn't
# decided as of the QA rollout — pick and fill in below)
DOMAIN_ROOT=landersfolk.com
API_SUBDOMAIN=api
ADMIN_SUBDOMAIN=admindashboard
KEYCLOAK_SUBDOMAIN=auth
ARTIFACTORY_SUBDOMAIN=artifactory-prod

# AWS — new KMS key for THIS box's Vault auto-unseal (Part 5.1/5.2 of the QA
# guide, done once via AWS Console; not scripted here since it's a one-time
# AWS-side action, same as it was for QA)
AWS_REGION=eu-west-1
KMS_KEY_ALIAS=landers-prod-vault-unseal
KMS_KEY_ID=<FILL IN — from AWS Console after creating the KMS key>

# RDS — a NEW prod RDS instance, separate from QA's (do not point prod at
# QA's database). Same DB/user names are fine since it's a different instance.
RDS_ENDPOINT=<FILL IN — prod RDS endpoint>
RDS_APP_DB_NAME=landers-app-lander-db
RDS_ADMIN_USER=dbadmin

# Keycloak — separate realm instance on this box; reusing the realm NAME
# "landers-realm" is fine (different Keycloak install entirely), but every
# client secret must be freshly generated by 04-setup-keycloak.sh, never
# copied from QA's.
KEYCLOAK_REALM=landers-realm

WEBSITE_PORT=4300
ADMIN_DASHBOARD_PORT=4400

GITHUB_ORG=landers-app
