# Environment-specific values for QA. Filled in from the values already live as of
# 2026-07-24 (see EC2_QA_Environment_Setup_Guide.txt / repo memory) — this file
# documents what QA actually runs on, and doubles as the reference for filling in
# prod.env when that box is provisioned.

ENVIRONMENT=qa
IMAGE_TAG=qa

# Host
EC2_HOSTNAME=landers-qa

# DNS / ALB (single-level subdomains only — the *.landersfolk.com wildcard cert
# does not cover two levels deep)
DOMAIN_ROOT=landersfolk.com
API_SUBDOMAIN=qa-api
ADMIN_SUBDOMAIN=qa-admindashboard
KEYCLOAK_SUBDOMAIN=keycloak-qa
ARTIFACTORY_SUBDOMAIN=artifactory-qa

# AWS
AWS_REGION=eu-west-1
KMS_KEY_ALIAS=landers-qa-vault-unseal
KMS_KEY_ID=ee8ceade-aa4b-4e1a-8290-73732dcc5851

# RDS (shared Postgres instance; Keycloak + app share the instance, separate DBs)
RDS_ENDPOINT=landers-db.c52kk2mayopg.eu-west-1.rds.amazonaws.com
RDS_APP_DB_NAME=landers-app-lander-db
RDS_ADMIN_USER=dbadmin

# Keycloak
KEYCLOAK_REALM=landers-realm

# Frontend host ports (bound by k3s ServiceLB, matched by ALB target groups)
WEBSITE_PORT=4300
ADMIN_DASHBOARD_PORT=4400

# GitHub org repos are cloned from (Part 1.5)
GITHUB_ORG=landers-app
